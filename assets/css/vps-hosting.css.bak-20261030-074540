/* TechTrac VPS Hosting page 2.0.0 */

.lov.lov-vps .vps-hero {
    background: linear-gradient(135deg, #021724, #092433);
    color: #ffffff;
}

.lov.lov-vps .vps-hero-inner {
    max-width: 1152px;
    margin: 0 auto;
    padding: 64px 20px 56px;
    display: flex;
    gap: 32px;
    align-items: flex-start;
}

.lov.lov-vps .vps-hero-copy h1 {
    font-size: clamp(2.3rem, 1.8rem + 1.6vw, 3rem);
    line-height: 1.15;
    margin-bottom: 14px;
}

.lov.lov-vps .vps-hero-copy .lo-lead {
    max-width: 44rem;
    margin-bottom: 20px;
}

.lov.lov-vps .vps-hero-actions .lo-btn {
    margin-right: 10px;
}

.lov.lov-vps .vps-hero-note {
    margin-top: 16px;
    max-width: 46rem;
    font-size: 0.92rem;
    color: #a7bbce;
}

.lov.lov-vps .vps-hero-aside {
    flex: 0 0 320px;
}

.lov.lov-vps .vps-hero-card {
    background: rgba(3, 22, 35, 0.9);
    border-radius: 12px;
    padding: 18px 20px;
    border: 1px solid rgba(109, 226, 241, 0.5);
}

.lov.lov-vps .vps-hero-card-title {
    font-size: 1.02rem;
    font-weight: 700;
    margin-bottom: 10px;
}

.lov.lov-vps .vps-hero-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.92rem;
}

.lov.lov-vps .vps-hero-list li {
    margin-bottom: 8px;
}

/* Sections */

.lov.lov-vps .vps-section {
    padding: 56px 20px;
}

.lov.lov-vps .vps-section-inner {
    max-width: 1152px;
    margin: 0 auto;
}

.lov.lov-vps .vps-section h2 {
    margin-bottom: 12px;
}

.lov.lov-vps .vps-section p {
    max-width: 60rem;
}

/* Grids */

.lov.lov-vps .vps-grid {
    display: grid;
    gap: 24px;
    margin-top: 24px;
}

.lov.lov-vps .vps-grid--two {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.lov.lov-vps .vps-grid--three {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
}

/* Cards */

.lov.lov-vps .vps-card {
    background: #0b1721;
    border-radius: 12px;
    padding: 18px 20px;
    border: 1px solid rgba(167, 187, 206, 0.4);
    color: #e6edf5;
}

.lov.lov-vps .vps-card h3 {
    margin-bottom: 8px;
}

.lov.lov-vps .vps-card--contrast {
    background: #081522;
}

.lov.lov-vps .vps-card--included {
    background: #081522;
}

/* Check / bullet lists */

.lov.lov-vps .vps-list {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    font-size: 0.95rem;
}

.lov.lov-vps .vps-list--check li::before {
    content: "✓";
    margin-right: 6px;
    color: #6de2f1;
}

.lov.lov-vps .vps-note {
    margin-top: 18px;
    font-size: 0.9rem;
    color: #a7bbce;
}

/* Plans */

.lov.lov-vps .vps-group {
    margin-top: 24px;
}

.lov.lov-vps .vps-group-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 12px;
}

.lov.lov-vps .vps-grid--plans {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
}

.lov.lov-vps .vps-plan {
    background: #0b1721;
    border-radius: 12px;
    padding: 18px 20px;
    border: 1px solid rgba(167, 187, 206, 0.4);
    display: flex;
    flex-direction: column;
    gap: 10px;
}

.lov.lov-vps .vps-plan--featured {
    border-color: #6de2f1;
    box-shadow: 0 0 0 1px rgba(109, 226, 241, 0.6);
}

.lov.lov-vps .vps-plan-name {
    font-size: 1rem;
    font-weight: 700;
}

.lov.lov-vps .vps-plan-desc {
    font-size: 0.9rem;
    color: #c4d1df;
}

.lov.lov-vps .vps-plan-price {
    display: flex;
    align-items: baseline;
    gap: 6px;
}

.lov.lov-vps .vps-price-main {
    font-size: 1.4rem;
    font-weight: 800;
    color: #ffffff;
}

.lov.lov-vps .vps-price-cycle {
    font-size: 0.85rem;
    color: #a7bbce;
    text-transform: capitalize;
}

.lov.lov-vps .vps-plan-price--contact .vps-price-main {
    font-size: 1rem;
    font-weight: 600;
    color: #a7bbce;
}

.lov.lov-vps .vps-resources {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    font-size: 0.9rem;
    color: #c4d1df;
}

.lov.lov-vps .vps-resources li {
    margin-bottom: 4px;
}

.lov.lov-vps .vps-resources-note {
    font-size: 0.85rem;
    color: #a7bbce;
}

.lov.lov-vps .vps-plan-note {
    font-size: 0.82rem;
    color: #a7bbce;
}

.lov.lov-vps .vps-plan-btn {
    margin-top: 6px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

/* FAQ */

.lov.lov-vps .vps-faq {
    display: grid;
    gap: 18px;
    margin-top: 20px;
}

.lov.lov-vps .vps-faq-item h3 {
    margin-bottom: 6px;
}

/* CTA */

.lov.lov-vps .vps-section--cta {
    background: #021724;
    color: #ffffff;
}

.lov.lov-vps .vps-section-inner--cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.lov.lov-vps .vps-cta-actions .lo-btn {
    margin-right: 10px;
}

/* Responsive */

@media (max-width: 900px) {
    .lov.lov-vps .vps-hero-inner {
        flex-direction: column;
    }

    .lov.lov-vps .vps-hero-aside {
        flex: 0 0 auto;
        width: 100%;
    }
}